# ==========================================
# MUSE2API 配置环境变量示例
# 复制为 .env 即可生效: cp .env.example .env
# 每一项都会被 compose 整份注入容器（env_file: .env），改完 docker compose up -d 即生效
# ==========================================

# ---------------------------------------------------------------
# 一、必须 / 常用：Docker 部署只要这一段就能跑
# ---------------------------------------------------------------
# 管理页与 API 的鉴权密钥（以 m2a_ 开头）。留空则首次启动自动生成并打印到日志
MUSE2API_KEY=m2a_your_secret_admin_key_here

# 镜像 tag：latest=最新构建；也可固定到版本号（如 1.6.12）或 sha-xxxxxxx 回滚
MUSE2API_TAG=latest

# 宿主机映射端口（容器内固定 18610，只改这一项，应用不用动）
MUSE2API_HOST_PORT=18610
# 宿主机绑定的网卡：127.0.0.1=只允许本机（反代 / SSH 隧道）访问，公网无法用 服务器IP:端口 打开；
# 想局域网内直接访问（比如 192.168.1.x:18610）才改成 0.0.0.0。注意这是 compose 的端口绑定，
# 不是下面那个 MUSE2API_HOST（那是应用在容器内监听什么地址）
MUSE2API_BIND_ADDR=127.0.0.1

# 时区：影响日志时间与每日保活调度
TZ=Asia/Shanghai

# 对外访问地址，如 https://api.yourdomain.com；留空则管理页自动用当前访问域名。
# 走反代、或要让下游客户端拿到媒体绝对 URL 时填上
MUSE2API_PUBLIC_BASE=

# ---------------------------------------------------------------
# 二、按需调整：不改也能跑，下面填的就是代码默认值 / 保守值
# ---------------------------------------------------------------
# 任务超时（秒）：图片 / 视频 / 对话
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# 最大并发生成任务数。注意代码内置默认是 8，这里写 2 是保守值；
# 机器和账号扛得住时调高可提升吞吐（每个并发多开一个 Chromium 上下文）
MUSE2API_CONCURRENCY=2

# 是否对后台已禁用的账号也执行静默保活（0=关闭，1=开启）
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# 参考图安全开关（默认全关；仅可信的单用户部署才考虑打开）
# 1：允许 API 请求读取服务器本地文件路径
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1：允许 API 请求下载内网/本机 URL；0 时逐跳检查并只允许公网 IP
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# 管理页「更新检测」对比的仓库与分支（默认指向本 fork，与镜像版本对齐）
# 换了自己的 fork 就改成 <你的用户名>/muse2api
MUSE2API_REPOSITORY=nowaytower/muse2api
MUSE2API_REPO_REF=main
# 镜像部署标记由 docker-compose.yml 固定为 1（面板据此隐藏「一键在线升级」，改用 compose 更新）。
# 裸机源码部署不要设这一项，保持默认 0，才能在面板里一键拉取上游代码。
# MUSE2API_MANAGED_DEPLOYMENT=0

# ---------------------------------------------------------------
# 三、仅裸机部署才需要：Docker 由镜像 ENV 和启动命令固定，改这里不生效
# ---------------------------------------------------------------
# 应用监听地址与端口（裸机直跑 uvicorn 用；容器内固定 0.0.0.0:18610）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Chromium 可执行文件路径（镜像内已是 /usr/bin/chromium，Windows 裸机才需要改）
MUSE2API_CHROMIUM=/usr/bin/chromium

# Chromium 的 CDP 调试端口：只在容器/本机内部使用（127.0.0.1），永不对外暴露。
# 代码默认 19210；Docker 部署不需要这行，只有裸机上 19210 被占用时才取消注释
# MUSE2API_CDP_PORT=19210
